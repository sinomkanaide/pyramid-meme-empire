# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/pyramid_meme_empire

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Robinhood Chain (Arbitrum Orbit L2, EVM-compatible)
# Public RPC has rate limits. In production set RPC_URL in Railway to the dedicated
# Alchemy endpoint (https://robinhood-mainnet.g.alchemy.com/v2/<KEY>).
# NEVER commit the keyed URL — keep it only as a Railway env var.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# USDG (Global Dollar) contract on Robinhood Chain — 6 decimals, same as USDC
USDG_CONTRACT_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# Shop Wallet (receives payments) — same EVM address works on Robinhood Chain
SHOP_WALLET_ADDRESS=0x323fF56B329F2bD3680007f8E6c4D9d48c7f3027

# Frontend URL (for CORS)
FRONTEND_URL=https://pyramid-meme-empire.vercel.app
